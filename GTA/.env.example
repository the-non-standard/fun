# ─── WANTED LEVEL — environment variables ───────────────────────────────
# Copy this file to .env.local for local dev, and add the same values in
# Vercel → Project → Settings → Environment Variables for production.
#
# Orders are emailed to you via Resend (https://resend.com — free tier is
# plenty to start). Until these are set, the order form falls back to a
# "email us" link so no order is ever lost.

# 1. Create a free Resend account and API key at https://resend.com/api-keys
RESEND_API_KEY=

# 2. Where new orders are delivered (your inbox).
ORDER_TO_EMAIL=you@example.com

# 3. The "from" address. For real sending, verify a domain in Resend and use
#    something like "WANTED LEVEL <orders@yourdomain.com>".
#    If you leave this blank it uses Resend's onboarding sender, which can
#    only deliver to the email on your Resend account (fine for testing).
ORDER_FROM_EMAIL=
